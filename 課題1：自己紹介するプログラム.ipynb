     "text": [
      "私の名前は hiroshi konnno です。来年で 43 歳になります。\n"
     ]
    }
   ],
   "source": [
    "def calc_next_age(age):\n",
    "    next_age = age + 1\n",
    "    return next_age\n",
    "\n",
    "name = input(\"名前を入力してください：\")\n",
    "age = int(input(\"現在の年齢を入力してください：\"))\n",
    "\n",
    "next_age = calc_next_age(age)\n",
    "\n",
    "print(f\"私の名前は {name} です。来年で {next_age} 歳になります。\")"
   ]
  }
 ],
